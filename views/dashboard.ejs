<%- include('partials/header', { title: 'Dashboard', bodyClass: 'dashboard-page' }) %>

<%- include('partials/_add_btn') %>
<div class="page-container">
    <h6>Dashboard</h6>
    <h3>Welcome <%= user.firstName %></h3>
    <p>Here are your stories</p>
    <% if (stories && stories.length > 0) { %>
        <table class="striped">
            <thead>
                <tr>
                    <th>Title</th>
                    <th>Date</th>
                    <th>Status</th>
                    <th></th>
                </tr>
            </thead>
            <tbody>
                <% stories.forEach(story => { %>
                    <tr>
                        <td>
                            <a href="/stories/<%= story._id %>"><%= story.title %></a>
                        </td>
                        <td><%= formatDate(story.createdAt, 'MMMM Do YYYY, h:mm:ss a') %></td>
                        <td><span class="dash-status"><%= story.status %></span></td>
                        <td class="action-buttons">
                            <a href="/stories/edit/<%= story._id %>" class="btn btn-float">
                                <i class="fas fa-edit"></i>
                            </a>

                            <form action="/stories/<%= story._id %>" method="POST" id="delete-form">
                                <input type="hidden" name="_method" value="DELETE">
                                <button type="submit" class="btn red">
                                    <i class="fas fa-trash"></i>
                                </button>
                            </form>

                        </td>
                    </tr>
                <% }) %>
            </tbody>
        </table>
    <% } else { %>
        <p>You have not created any stories</p>
    <% } %>
</div>

<%- include('partials/footer', { currentYear: new Date().getFullYear() }) %>