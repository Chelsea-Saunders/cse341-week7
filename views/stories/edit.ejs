<%- include('../partials/header', { title: 'Add Story' }) %>

<h3 class="title">Edit Story</h3>
<div class="row">
    <form action="/stories/<%= story._id %>?_method=PUT" method="post" class="col s12">
        <input type="hidden" name="_method" value="PUT">
        <div class="row">
            <div class="input-field">
                <input type="text" id="title" name="title" value="<%= typeof story !== 'undefined' ? story.title : '' %>">
                <label for="title">Title</label>
            </div>
        </div>

        <div class="row">
            <div class="input-field">
                <select id="status" name="status">
                    <option value="public" <%= story.status === 'public' ? 'selected' : '' %>>Public</option>
                    <option value="private" <%= story.status === 'private' ? 'selected' : '' %>>Private</option>
                </select>
            </div>
        </div>

        <div class="row">
            <div class="input-field">
                <h5>Tell Us Your Story:</h5>
                <textarea id="body" name="body"><%= typeof story !== 'undefined' ? story.body : '' %></textarea>
            </div>
        </div>

        <div class="row">
            <input type="submit" value="Save" class="btn">
            <a href="/dashboard" class="btn orange">Cancel</a>
        </div>
    </form>
</div>

<%- include('../partials/footer', { currentYear: new Date().getFullYear() }) %>