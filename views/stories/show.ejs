<%- include('../partials/header', { title: story.title }) %>

<div class="row">
    <!-- Left Column: Story Content -->
    <div class="col s12 m8">
        <h3><%= story.title %>
            <small><%- editIcon(story.user, user, story._id) %></small>
        </h3>
        <div class="card story">
            <div class="card-content">
                <span class="card-title"><%= formatDate(story.createdAt, 'MMMM Do YYYY, h:mm:ss a') %></span>
                <%# Triple equals prints unscaped HTML rendered by CKEditor %>
                <%- story.body %>
            </div>
        </div>
    </div>

    <!-- Right Column: Author Card -->
    <div class="col s12 m4">
        <div class="card center-align">
            <div class="card-content">
                <span class="card-title"><%= story.user.displayName || story.user.firstName %></span>
                <% if (story.user.image) { %>
                <img src="<%= story.user.image %>" alt="User Avatar" class="circle responsive-img img-small">
                <% } %>
            </div>
            <div class="card-action">
                <a href="/stories/user/<%= story.user._id %>" class="btn gray">More From <%= story.user.firstName %></a>
            </div>
        </div>
    </div>
</div>

<%- include('../partials/footer', {currentYear: new Date().getFullYear() }) %>